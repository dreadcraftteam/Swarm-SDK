$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"mod_sdkscratch"

$Include "$SRCDIR\game\client\client_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;.\sdk;.\hl2;.\sdk\vgui;$SRCDIR\game\client\gameui;$SRCDIR\game\client\sdk\scratchui;..\statemachine;$SRCDIR\game\shared\multiplayer;$SRCDIR\game\shared\sdk"
		$PreprocessorDefinitions		"$BASE;SDK_CLIENT_DLL;SDK_DLL;GAMEUI_EMBEDDED;GAMEUI_EXPORTS;USE_DETAIL_SHAPES"
		$TreatWarningsAsErrors			"No (/WX-)"
	}
}

