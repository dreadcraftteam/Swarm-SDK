//-----------------------------------------------------------------------------
//	CLIENT_SDK.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"mod_sdk"

$Include "$SRCDIR\game\client\client_base.vpc"

//
// SDK Preprocessor Defenitions
//
// SDK_USE_STAMINA - Do your players have stamina? - this is a pre-requisite for sprinting, if you define sprinting, and don't uncomment this, it will be included anyway.
// SDK_USE_SPRINTING - Are your players able to sprint?
// SDK_SHOOT_WHILE_JUMPING - Do you want your players to be able to shoot while jumping?
// SDK_USE_PRONE - Can your players go prone?
// SDK_SHOOT_WHILE_SPRINTING - If you're allowing sprinting, do you want to be able to shoot while sprinting?
// SDK_SHOOT_ON_LADDERS - Do you want your players to be able to shoot while climing ladders?
//

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories		"$BASE;.\sdk;.\sdk\vgui;.\sdk\hud;$SRCDIR\game\shared\sdk;$SRCDIR\game\shared\Multiplayer;.\gameui;.\gameui\matchmaking"
		$PreprocessorDefinitions		"$BASE;USE_DETAIL_SHAPES;ENABLE_HTMLWINDOW;SDK_DLL;SWARM_DLL;SDK_USE_STAMINA;SDK_USE_SPRINTING;SDK_SHOOT_WHILE_JUMPING;NEXT_BOT;GAMEUI_EMBEDDED;GAMEUI_EXPORTS"
		
	}
}

